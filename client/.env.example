# Copy to client/.env (Vite reads VITE_-prefixed vars at build time)
VITE_BACKEND_URL=https://your-backend.onrender.com

# --- TURN relay (strongly recommended before inviting real testers) ---
# STUN alone fails for ~10-20% of network pairs (corporate/university
# firewalls, some mobile carriers). Managed options with free tiers:
# Metered Open Relay, Cloudflare TURN; Twilio also offers TURN.
# Comma-separate multiple URLs.
# VITE_TURN_URLS=turn:your-relay.example.com:443?transport=tcp
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
