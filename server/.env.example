# Copy to server/.env and fill in real values. Never commit .env to git.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/videochat
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
CLIENT_ORIGIN=https://your-frontend.example.com
PORT=5000

# Optional: participants allowed per room (default 10)
# MAX_ROOM_SIZE=10

# Optional: login session lifetime (default 24h)
# TOKEN_TTL=24h
