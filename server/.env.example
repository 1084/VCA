# Copy to server/.env and fill in real values. Never commit .env to git.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/videochat
JWT_SECRET=<generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
# One origin, or a comma-separated list while two front ends are live
CLIENT_ORIGIN=https://cove.johnhubert.llc,https://vcacoveapp.netlify.app
PORT=5000

# Optional: participants allowed per room (default 10)
# MAX_ROOM_SIZE=10

# Optional: login session lifetime (default 24h)
# TOKEN_TTL=24h

# TURN relay (Cloudflare Realtime → TURN Server → create a key). Credentials are
# minted per room join with a 1-hour lifetime by GET /api/turn; nothing is baked
# into the client. Leave unset for STUN-only (strict NATs will fail to connect).
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# TURN_TTL=3600

# Cove Rooms: invited hosts (comma-separated emails). Hosts can create named
# rooms (/r/<slug>) that guests enter without an account.
HOST_EMAILS=you@example.com
# Reads reports and the room list: GET /api/admin/reports with
# "Authorization: Bearer <ADMIN_KEY>". Generate with: openssl rand -hex 32
ADMIN_KEY=

# Language room: translate caption text (never audio). Free DeepL keys end in ":fx".
# Leave empty to run captions without translation.
DEEPL_API_KEY=
